{
  "name": "cloud10-forecast",
  "main": "../../dist/cloudflare-production/production.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud10-forecast-pilot",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "22-34 */6 * * *"
    ]
  },
  "assets": {
    "directory": "../../dist/cloudflare-production/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": true
}
